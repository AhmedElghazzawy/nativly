          "difficulty",
          "prompt",
          "type",
          "options"
        ],
        "title": "McqPublic"
      },
      "McqResponse": {
        "properties": {
          "type": {
            "type": "string",
            "const": "mcq",
            "title": "Type"
          },
          "choice": {
