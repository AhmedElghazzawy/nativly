  "components": {
    "schemas": {
      "AttemptRequest": {
        "properties": {
          "response": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/McqResponse"
              },
              {
                "$ref": "#/components/schemas/ClozeResponse"
              },
              {
                "$ref": "#/components/schemas/ReorderResponse"
              }
            ],
            "title": "Response",
            "discriminator": {
              "propertyName": "type",
              "mapping": {
                "cloze": "#/components/schemas/ClozeResponse",
                "mcq": "#/components/schemas/McqResponse",
                "reorder": "#/components/schemas/ReorderResponse"
              }
            }
          },
          "lesson_slug": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lesson Slug",
            "description": "Lesson the exercise was done in; records lesson progress"
          },
          "duration_ms": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 3600000.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Duration Ms"
          }
        },
        "type": "object",
        "required": [
          "response"
        ],
        "title": "AttemptRequest"
      },
      "AttemptResult": {
        "properties": {
          "is_correct": {
            "type": "boolean",
            "title": "Is Correct"
          },
          "score": {
            "type": "number",
            "title": "Score"
          },
          "correct_answer": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            ],
            "title": "Correct Answer",
            "description": "mcq: option index \u00b7 cloze: one accepted answer per blank \u00b7 reorder: tokens"
          },
          "explanation": {
            "type": "string",
            "title": "Explanation"
          },
          "mastery": {
            "$ref": "#/components/schemas/MasteryRead"
          }
        },
        "type": "object",
        "required": [
          "is_correct",
          "score",
          "correct_answer",
          "explanation",
          "mastery"
        ],
        "title": "AttemptResult"
      },
      "CefrLevel": {
        "type": "string",
        "enum": [
          "A1",
          "A2",
          "B1",
          "B2",
          "C1",
          "C2"
        ],
        "title": "CefrLevel"
      },
      "ClozePublic": {
        "properties": {
          "slug": {
            "type": "string",
            "title": "Slug"
          },
          "difficulty": {
            "type": "integer",
            "title": "Difficulty"
          },
          "prompt": {
            "type": "string",
            "title": "Prompt"
          },
          "type": {
            "type": "string",
            "const": "cloze",
            "title": "Type"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "blanks": {
            "type": "integer",
            "title": "Blanks"
          }
        },
        "type": "object",
        "required": [
          "slug",
          "difficulty",
          "prompt",
          "type",
          "text",
          "blanks"
        ],
        "title": "ClozePublic"
      },
      "ClozeResponse": {
        "properties": {
          "type": {
            "type": "string",
            "const": "cloze",
            "title": "Type"
          },
          "blanks": {
            "items": {
              "type": "string",
              "maxLength": 200
            },
            "type": "array",
            "maxItems": 20,
            "minItems": 1,
            "title": "Blanks"
          }
        },
        "type": "object",
        "required": [
          "type",
          "blanks"
        ],
        "title": "ClozeResponse"
      },
      "CourseDetail": {
        "properties": {
          "slug": {
            "type": "string",
            "title": "Slug"
          },
          "language": {
            "type": "string",
            "title": "Language"
          },
          "cefr_level": {
            "$ref": "#/components/schemas/CefrLevel"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "units": {
            "items": {
              "$ref": "#/components/schemas/UnitOutline"
            },
            "type": "array",
            "title": "Units"
          }
        },
        "type": "object",
        "required": [
          "slug",
          "language",
          "cefr_level",
          "title",
          "description",
          "units"
        ],
        "title": "CourseDetail"
      },
      "CourseSummary": {
        "properties": {
          "slug": {
            "type": "string",
            "title": "Slug"
          },
          "language": {
            "type": "string",
            "title": "Language"
          },
          "cefr_level": {
            "$ref": "#/components/schemas/CefrLevel"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "description": {
            "type": "string",
            "title": "Description"
          }
        },
        "type": "object",
        "required": [
          "slug",
          "language",
          "cefr_level",
          "title",
          "description"
        ],
        "title": "CourseSummary"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "unavailable"
            ],
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "HealthResponse"
      },
      "LessonDetail": {
        "properties": {
          "slug": {
            "type": "string",
            "title": "Slug"
          },
          "position": {
            "type": "integer",
            "title": "Position"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "summary": {
            "type": "string",
            "title": "Summary"
          },
          "estimated_minutes": {
            "type": "integer",
            "title": "Estimated Minutes"
          },
          "course_slug": {
            "type": "string",
            "title": "Course Slug"
          },
          "unit_slug": {
            "type": "string",
            "title": "Unit Slug"
          },
          "objectives": {
            "items": {
              "$ref": "#/components/schemas/ObjectiveRead"
            },
            "type": "array",
            "title": "Objectives"
          },
          "steps": {
            "items": {
              "$ref": "#/components/schemas/StepRead"
            },
            "type": "array",
            "title": "Steps"
          }
        },
        "type": "object",
        "required": [
          "slug",
          "position",
          "title",
          "summary",
          "estimated_minutes",
          "course_slug",
          "unit_slug",
          "objectives",
          "steps"
        ],
        "title": "LessonDetail"
      },
      "LessonProgressRead": {
        "properties": {
          "lesson_slug": {
            "type": "string",
            "title": "Lesson Slug"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "status": {
            "$ref": "#/components/schemas/LessonStatus"
          },
          "score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Score"
          },
          "started_at": {
            "type": "string",
            "format": "date-time",
            "title": "Started At"
          },
          "completed_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Completed At"
          }
        },
        "type": "object",
        "required": [
          "lesson_slug",
          "title",
          "status",
          "score",
          "started_at",
          "completed_at"
        ],
        "title": "LessonProgressRead"
      },
      "LessonStatus": {
        "type": "string",
        "enum": [
          "in_progress",
          "completed"
        ],
        "title": "LessonStatus"
      },
      "LessonSummary": {
        "properties": {
          "slug": {
            "type": "string",
            "title": "Slug"
          },
          "position": {
            "type": "integer",
            "title": "Position"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "summary": {
            "type": "string",
            "title": "Summary"
          },
          "estimated_minutes": {
            "type": "integer",
            "title": "Estimated Minutes"
          }
        },
        "type": "object",
        "required": [
          "slug",
          "position",
          "title",
          "summary",
          "estimated_minutes"
        ],
        "title": "LessonSummary"
      },
      "LoginRequest": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest"
      },
      "MasteryRead": {
        "properties": {
          "objective_slug": {
            "type": "string",
            "title": "Objective Slug"
          },
          "mastery": {
            "type": "number",
            "title": "Mastery"
          }
        },
        "type": "object",
        "required": [
          "objective_slug",
          "mastery"
        ],
        "title": "MasteryRead"
      },
      "McqPublic": {
        "properties": {
          "slug": {
            "type": "string",
            "title": "Slug"
          },
          "difficulty": {
            "type": "integer",
            "title": "Difficulty"
          },
          "prompt": {
            "type": "string",
            "title": "Prompt"
          },
          "type": {
            "type": "string",
            "const": "mcq",
            "title": "Type"
          },
          "options": {
            "items": {
              "type": "string"
